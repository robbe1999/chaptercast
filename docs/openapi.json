          "auth_required",
          "max_chars_per_job",
          "chunk_max_chars",
          "cache_enabled"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "CreateJobRequest": {
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9_]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Model to use; one of GET /api/models. Defaults to the server default.",
            "title": "Model Id"
          },
          "text": {
            "description": "The text to narrate.",
            "maxLength": 200000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "voice_id": {
            "description": "Voice identifier.",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Voice Id",
            "type": "string"
          },
          "voice_settings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VoiceSettingsBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "text",
          "voice_id"
        ],
        "title": "CreateJobRequest",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
