        "properties": {
          "audio_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Url"
          },
          "billed_characters": {
            "description": "Characters actually sent to the provider.",
            "title": "Billed Characters",
            "type": "integer"
          },
          "cached_chunks": {
            "description": "Chunks reused from the cache instead of re-generated.",
            "title": "Cached Chunks",
            "type": "integer"
          },
          "captions": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaptionLinks"
              },
              {
                "type": "null"
              }
            ]
          },
          "char_count": {
            "title": "Char Count",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
