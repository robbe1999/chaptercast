            "type": "string"
          },
          "transcript_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript Url"
          },
          "voice_id": {
            "title": "Voice Id",
            "type": "string"
          },
          "word_timings": {
            "description": "Whether the model returned word timings (read-along and captions).",
            "title": "Word Timings",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status",
          "voice_id",
          "model_id",
          "char_count",
          "progress",
          "cached_chunks",
          "billed_characters",
          "created_at",
          "duration_seconds",
          "audio_url",
          "word_timings",
          "transcript_url",
          "captions",
          "error"
        ],
        "title": "JobResponse",
        "type": "object"
      },
      "ModelCapabilities": {
        "properties": {
          "audio_tags": {
            "description": "Understands expression tags such as [warm].",
            "title": "Audio Tags",
