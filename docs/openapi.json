            "title": "Estimated Credits",
            "type": "integer"
          },
          "max_chars_per_job": {
            "title": "Max Chars Per Job",
            "type": "integer"
          },
          "tags_ignored": {
            "description": "The text has tags the chosen model would read aloud, so they are removed.",
            "title": "Tags Ignored",
            "type": "boolean"
          },
          "within_limit": {
            "title": "Within Limit",
            "type": "boolean"
          }
        },
        "required": [
          "characters",
          "chunks",
          "cached_chunks",
          "billable_characters",
          "cost_multiplier",
          "estimated_credits",
          "max_chars_per_job",
          "within_limit",
          "daily_budget_remaining",
          "tags_ignored"
        ],
        "title": "EstimateResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
