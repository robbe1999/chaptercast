          },
          "style": {
            "title": "Style",
            "type": "boolean"
          },
          "timestamps": {
            "description": "Word timings for the read-along and captions.",
            "title": "Timestamps",
            "type": "boolean"
          }
        },
        "required": [
          "timestamps",
          "context_stitching",
          "style",
          "speaker_boost",
          "audio_tags",
