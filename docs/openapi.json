        "title": "VoiceResponse",
        "type": "object"
      },
      "VoiceSettingsBody": {
        "additionalProperties": false,
        "description": "Optional voice tuning. Omitted fields use the voice's stored defaults.",
        "properties": {
          "similarity_boost": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "How closely to match the original voice.",
            "title": "Similarity Boost"
          },
          "speed": {
            "anyOf": [
              {
                "maximum": 1.2,
                "minimum": 0.7,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Speaking rate.",
            "title": "Speed"
          },
          "stability": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lower is more expressive, higher more consistent.",
            "title": "Stability"
          },
          "style": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Style exaggeration (models that support it).",
            "title": "Style"
          },
          "use_speaker_boost": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Boost similarity to the speaker (models that support it).",
            "title": "Use Speaker Boost"
          }
        },
        "title": "VoiceSettingsBody",
        "type": "object"
      },
