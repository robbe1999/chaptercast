# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# With no ELEVENLABS_API_KEY the app runs in DEMO mode: it makes no network
# calls and returns synthetic tones, so you can try the whole pipeline for free.

# --- ElevenLabs (server side only; the browser never sees this) -------------
ELEVENLABS_API_KEY=

# --- Provider selection: auto | elevenlabs | demo ---------------------------
# auto = elevenlabs when a key is set, otherwise demo
CHAPTERCAST_PROVIDER=auto

# --- Protect a public deployment (strongly recommended) ---------------------
# Min 16 chars. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAPTERCAST_ACCESS_TOKEN=

# --- Cost guards (characters, not requests) ---------------------------------
CHAPTERCAST_MAX_CHARS_PER_JOB=5000
CHAPTERCAST_DAILY_CHAR_BUDGET=25000

# --- Optional ---------------------------------------------------------------
# Only needed if the frontend is served from a different origin than the API.
# CHAPTERCAST_CORS_ORIGINS=http://localhost:5173
# Set true only when running behind a reverse proxy you control.
# CHAPTERCAST_TRUST_PROXY_HEADERS=false
# CHAPTERCAST_LOG_LEVEL=INFO
